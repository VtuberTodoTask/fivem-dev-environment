# ===========================================
# FiveM 開発環境 設定ファイル
# ===========================================
# このファイルを .env にコピーして値を設定してください
#   cp .env.example .env
# ===========================================

# -------------------------------------------
# FiveM サーバー設定
# -------------------------------------------
# FXServer アーティファクトバージョン
# https://runtime.fivem.net/artifacts/fivem/build_proot_linux/master/ で確認
# デフォルト: 29586（最新安定版）
# FIVEM_VERSION=29586-3284e7bf7ac848fcf3ccd51432279fdc3a76245b

# FiveM ゲームポート（デフォルト: 30120）
FIVEM_PORT=30120

# txAdmin Web UI ポート（デフォルト: 40120）
TXADMIN_PORT=40120

# -------------------------------------------
# MariaDB 設定
# -------------------------------------------
# MariaDB ルートパスワード
MYSQL_ROOT_PASSWORD=fivem_root_pass

# FiveM 用データベース名
MYSQL_DATABASE=fivem

# FiveM 用データベースユーザー
MYSQL_USER=fivem

# FiveM 用データベースパスワード
MYSQL_PASSWORD=fivem_pass

# MariaDB ポート（デフォルト: 3306）
MARIADB_PORT=3306

# -------------------------------------------
# txAdmin から MariaDB への接続文字列
# -------------------------------------------
# server.cfg に以下を設定してください:
# set mysql_connection_string "mysql://fivem:fivem_pass@fivem-mariadb:3306/fivem?charset=utf8mb4"
